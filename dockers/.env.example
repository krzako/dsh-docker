DSH_SOURCE="./deepseek-harness"

# Provider API keys handed to the DSH container. Each name matches the
# provider's apiKeyEnv entry in settings.seed.yaml (provider name in upper
# case + _API_KEY). An empty or missing value means the key is not provided.
LLM_PROXY_UPSTREAM=http://host.docker.internal:1234
LLM_PROXY_API_KEY=<OPENAI_API_KEY>
LLM_PROXY_PORT=9090

OPEN_WEBUI_PORT=9999
OPEN_TERMINAL_API_KEY=byle_jaki_klucz_w_sumie_tu_moze_byc

COPILOT_PROXY_API_KEY=my_copilot_api_key
COPILOT_PROXY_GHE_HOST=
#COPILOT_PROXY_COPILOT_SDK_LOG_LEVEL=warning
COPILOT_PROXY_PORT=9091
COPILOT_PROXY_LOG_LEVEL=debug
COPILOT_PROXY_LOG_REQUESTS=true
