# Docker build context with the DSH source (relative paths are resolved
# against the compose file directory, i.e. dockers/).
DSH_SOURCE="../deepseek-harness"

# Commit hash of the DSH source used for the image build. The start scripts
# (start.sh / restart.sh / tools/test_instance_build.sh) set it automatically
# from the DSH_SOURCE checkout -- only define it here to override that, e.g.
# to pin a specific commit:
#DSH_COMMIT_HASH=

# Volume sharing: the containers run as their image default users (dsh,
# open-webui and searxng run as root). Files they create in ../volumes/*
# inherit the invoking user's primary group (setgid on the volume
# directories) and are group-writable (umask 0002 in the container
# entrypoints), so no UID/GID overrides are needed. New bind dirs are
# prepared by the start scripts; normalize an existing tree once with:
#   sudo tools/fix_volume_permissions.sh
# (the dsh-git bridge runs as fixed non-root 1000:1000, see
# dsh-git/README.md).

# Session secret for the open-webui container (defaults to a fixed local-dev
# key so sessions survive restarts; set your own for any exposed deployment).
#WEBUI_SECRET_KEY=

# Provider API keys handed to the DSH container. Each name matches the
# provider's apiKeyEnv entry in settings.seed.yaml (provider name in upper
# case + _API_KEY). An empty or missing value means the key is not provided.
LLM_PROXY_UPSTREAM=http://host.docker.internal:1234
LLM_PROXY_API_KEY=<OPENAI_API_KEY>
LLM_PROXY_PORT=9090

OPEN_WEBUI_PORT=9999
OPEN_TERMINAL_API_KEY=byle_jaki_klucz_w_sumie_tu_moze_byc

COPILOT_PROXY_API_KEY=my_copilot_api_key
COPILOT_PROXY_GHE_HOST=
#COPILOT_PROXY_COPILOT_SDK_LOG_LEVEL=warning
COPILOT_PROXY_PORT=9091
COPILOT_PROXY_LOG_LEVEL=debug
COPILOT_PROXY_LOG_REQUESTS=true
