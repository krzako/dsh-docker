HOST=127.0.0.1
PORT=3098

# Optional. If set, clients must send Authorization: Bearer <value>.
PROXY_API_KEY=xxx

# Start the already-authenticated CLI separately with:
#   copilot --headless --port 4321
COPILOT_RUNTIME_URL=host.docker.internal:4321

COPILOT_GITHUB_TOKEN=
GITHUB_TOKEN=


# Optional, and recommended for local OAuth login on Windows/GHE.
# Start the already-authenticated CLI separately with:
#   copilot --headless --port 4321
# Then point the proxy at it. The external CLI owns authentication.
COPILOT_RUNTIME_URL=localhost:4321

# Usually leave this alone. For Docker it should be a persistent volume.
COPILOT_HOME=

# none | error | warning | info | debug | all
COPILOT_LOG_LEVEL=warning

# Maximum accepted HTTP request body.
MAX_BODY_BYTES=16777216
