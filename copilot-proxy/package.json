{
  "name": "copilot-openai-proxy",
  "version": "0.1.1",
  "private": true,
  "description": "OpenAI-compatible proxy backed by GitHub Copilot SDK",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "copilot": "copilot",
    "copilot:headless": "copilot --headless --port 4321"
  },
  "dependencies": {
    "@github/copilot-sdk": "1.0.8",
    "dotenv": "^17.2.2"
  },
  "devDependencies": {
    "@github/copilot": "1.0.80",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
